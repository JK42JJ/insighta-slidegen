{
  "name": "insighta-slidegen",
  "version": "0.1.0",
  "description": "insighta-slidegen — video card v2 rich-summary → Google Slides + true-vector PDF pipeline",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "slidegen": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' --no-error-on-unmatched-pattern",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "slidegen": "node dist/cli/index.js",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prepare": "lefthook install"
  },
  "keywords": [
    "slides",
    "google-slides",
    "pdf",
    "vector",
    "insighta",
    "knowledge-management",
    "video",
    "summarization",
    "cli",
    "pipeline"
  ],
  "author": "JK42JJ",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/JK42JJ/insighta-slidegen.git"
  },
  "bugs": {
    "url": "https://github.com/JK42JJ/insighta-slidegen/issues"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "dotenv": "^16.3.1",
    "tslib": "^2.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "lefthook": "^2.1.9",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  }
}
