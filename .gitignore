.claude/settings.local.json

# memsearch local index + memory snapshots (machine-local; may hold memory
# content — NEVER commit to this PUBLIC repo).
.memsearch/

# Prisma dev DB
prisma/dev.db
prisma/dev.db-journal

# Python venvs / build artifacts
*.egg-info/
dist-info/
