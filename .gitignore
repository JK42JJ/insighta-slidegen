logs/
*.log
npm-debug.log*

# Testing / coverage
coverage/
.nyc_output/
*.lcov

# Cache
.cache/
*.cache
__pycache__/
.venv/
py/**/__pycache__/
mac-mini/**/__pycache__/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temp
temp/
tmp/
*.tmp

# Local secrets / config (never committed)
*.local.json
.mcp.json

# Claude Code: commands/skills/agents ARE tracked (project workflow inherited from insighta).
