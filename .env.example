# insighta-slidegen — environment variable template
# Copy to .env and fill in values. The .env file is gitignored; NEVER commit values.
# All keys below are required unless marked (optional) or (prod-only).
#
# PROD-ONLY KEYS: keys marked (prod-only) must NOT be set in dev/test environments.
# They are reserved for the production pipeline and their use in local runs will
# trigger unintended API calls and billing.

# ── Database (Insighta Supabase — READ source + slide_* write sink) ───────────
# Connection string for Prisma (pooled, via Supabase connection pooler).
DATABASE_URL=

# Direct connection string (non-pooled, used for migrations / raw DDL).
DIRECT_URL=

# ── Supabase (read-only access to Insighta card/video data) ──────────────────
# Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# Service role key — grants read access to insighta tables.
# This key is a secret; never log or expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket where generated slide assets are stored.
SUPABASE_STORAGE_BUCKET=slidegen-assets

# ── CV service (Mac Mini local-first, vision extraction + figure redraw) ─────
# URL of the local CLIP/YOLO/OCR service running on Mac Mini.
# In dev: typically http://localhost:8765
# In prod: internal Tailscale URL (set via secret, never commit the actual IP).
SLIDEGEN_CV_SERVICE_URL=

# Bearer token for authenticating requests to the CV service.
SLIDEGEN_CV_SERVICE_TOKEN=

# ── Pipeline mode ─────────────────────────────────────────────────────────────
# Controls whether the pipeline runs in local dev mode or production mode.
# Values: dev | prod
# dev  — uses local CV service; skips prod-only API calls.
# prod — enables vision API fallback (see VISION_API_PROVIDER below).
SLIDEGEN_MODE=dev

# ── Google Slides + Drive API ─────────────────────────────────────────────────
# OAuth2 client credentials (from Google Cloud Console, OAuth 2.0 client).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Long-lived refresh token obtained via the OAuth consent flow.
# Store in gitignored token.json at runtime; this env var is the fallback.
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── Vision API (prod-only fallback when Mac Mini CV service is unavailable) ───
# Values: gemini | none
# MUST NOT be set in dev/test — setting it in dev will cause accidental API calls.
# (prod-only) — leave blank in .env for local development.
VISION_API_PROVIDER=

# Gemini API key — used ONLY when VISION_API_PROVIDER=gemini AND SLIDEGEN_MODE=prod.
# (prod-only) — leave blank in .env for local development.
GEMINI_API_KEY=

# ── Model endpoints (docs/CONTRACT_model-endpoints.md v1.0 §5) ────────────────
# All keys below are (optional): unset/blank = mock backend, no live endpoints
# (CI-safe). Live tokens are REFUSED in dev unless SLIDEGEN_VLM_BACKEND=http.

# VLM backend selector: mock (default) | transformers | mlx | http.
# "http" is the ONLY value that enables live model-endpoint calls (opt-in).
SLIDEGEN_VLM_BACKEND=

# Qwen3-VL vLLM endpoint base URL (OpenAI-compatible). (prod-only / http opt-in)
SLIDEGEN_VLM_BASE_URL=

# Bearer token for the VLM endpoint. (prod-only / http opt-in)
SLIDEGEN_VLM_TOKEN=

# Model id served by the vLLM endpoint (tuning knob, not a secret).
SLIDEGEN_VLM_MODEL=

# DocLayout-YOLO FastAPI endpoint base URL. (prod-only / http opt-in)
SLIDEGEN_YOLO_BASE_URL=

# Bearer token for the YOLO endpoint. (prod-only / http opt-in)
SLIDEGEN_YOLO_TOKEN=

# S3 handoff bucket (§4) — backend (presign issuer) ONLY; model hosts receive
# presigned URLs, never credentials or the bucket name. (prod-only)
SLIDEGEN_S3_BUCKET=

# Presigned-URL expiry in seconds (tuning knob; default 900 = 15 min).
SLIDEGEN_PRESIGN_EXPIRY_SEC=
